# Environment
.venv/
__pycache__/
*.pyc

# Scan artifacts: results JSON runs to ~10 MB each and HTML reports to ~4.5 MB,
# and both are regenerated by `streamlit run app.py`.
results/*.json
results/*.html

# Score cache. Deterministic and rebuildable, just slow to refill.
.rmi_cache/
*.sqlite

# Tooling
.pytest_cache/
.DS_Store
